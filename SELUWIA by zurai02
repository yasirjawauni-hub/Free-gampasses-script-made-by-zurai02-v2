-- ─── ADD LOG ─────────────────────────────────────────────────────────
local function addLog(label, id, signalType)
    if suppressCounter > 0 then return end

    eventCount += 1
    refreshStatus()

    local entryId = eventCount
    local idStr   = tostring(id)
    local tag     = label .. " · " .. idStr

    EventsTab:CreateSection(tag)

    -- fire once
    EventsTab:CreateButton({
        Name     = "fire once",
        Callback = function()
            fireFakeSignal(signalType, id)
            notify("fired · " .. idStr)
        end,
    })

    -- spam toggle
    local isSpamming = false
    local spamThread = nil
    local spamBtn

    local function stopSpam()
        isSpamming = false
        if spamThread then task.cancel(spamThread) spamThread = nil end
        activeSpam[entryId] = nil
        if spamBtn then spamBtn:Set("spam · off") end
        refreshStatus()
    end

    local function startSpam()
        if isSpamming then return end
        isSpamming = true
        if spamBtn then spamBtn:Set("spam · on — tap stop") end
        spamThread = task.spawn(function()
            while isSpamming do
                fireFakeSignal(signalType, id)
                task.wait(SPAM_INTERVAL)
            end
        end)
        activeSpam[entryId] = stopSpam
        refreshStatus()
        notify("spam · " .. idStr)
    end

    spamBtn = EventsTab:CreateButton({
        Name     = "spam · off",
        Callback = function()
            if isSpamming then stopSpam() else startSpam() end
        end,
    })

    -- auto toggle
    local autoActive = false
    local autoThread = nil
    local autoBtn

    local function stopAuto()
        autoActive = false
        if autoThread then task.cancel(autoThread) autoThread = nil end
        activeAuto[entryId] = nil
        if autoBtn then autoBtn:Set("auto · off") end
        refreshStatus()
    end

    local function startAuto()
        if autoActive then return end
        autoActive = true
        if autoBtn then autoBtn:Set("auto · on — tap stop") end
        autoThread = task.spawn(function()
            while autoActive do
                fireFakeSignal(signalType, id)
                task.wait(autoSpeed > 0 and (1 / autoSpeed) or 0.01)
            end
        end)
        activeAuto[entryId] = stopAuto
        refreshStatus()
        notify("auto · " .. idStr .. " · " .. autoSpeed .. "/s")
    end

    autoBtn = EventsTab:CreateButton({
        Name     = "auto · off",
        Callback = function()
            if autoActive then stopAuto() else startAuto() end
        end,
    })

    -- copy id
    EventsTab:CreateButton({
        Name     = "copy id",
        Callback = function()
            pcall(setclipboard, idStr)
            notify("copied · " .. idStr)
        end,
    })
end

