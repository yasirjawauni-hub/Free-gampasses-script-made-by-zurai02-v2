-- ─── BUTTON HELPER ───────────────────────────────────────────────────
local function makeBtn(parent, text, x, w)
    local b = Instance.new("TextButton")
    b.Size             = UDim2.new(0, w, 0, 26)
    b.Position         = UDim2.new(0, x, 0.5, -13)
    b.BackgroundColor3 = Color3.fromRGB(18, 18, 26)
    b.Text             = text
    b.TextColor3       = Color3.fromRGB(160, 155, 210)
    b.TextSize         = 10
    b.Font             = Enum.Font.GothamBold
    b.BorderSizePixel  = 0
    b.ZIndex           = 3
    b.Parent           = parent
    local c = Instance.new("UICorner", b) c.CornerRadius = UDim.new(0, 6)
    local s = Instance.new("UIStroke", b) s.Color = Color3.fromRGB(44, 42, 64) s.Thickness = 1
    b.MouseEnter:Connect(function() b.BackgroundColor3 = Color3.fromRGB(24, 22, 36) end)
    b.MouseLeave:Connect(function() b.BackgroundColor3 = Color3.fromRGB(18, 18, 26) end)
    return b
end

-- ─── SIGNAL HELPER ───────────────────────────────────────────────────
local function fireFakeSignal(signalType, id)
    suppressCounter += 1
    pcall(function()
        if signalType == "Product" then
            MarketplaceService:SignalPromptProductPurchaseFinished(player.UserId, id, true)
        elseif signalType == "Gamepass" then
            MarketplaceService:SignalPromptGamePassPurchaseFinished(player, id, true)
        elseif signalType == "Bulk" then
            MarketplaceService:SignalPromptBulkPurchaseFinished(player.UserId, id, true)
        elseif signalType == "Purchase" then
            MarketplaceService:SignalPromptPurchaseFinished(player.UserId, id, true)
        end
    end)
    suppressCounter -= 1
end

-- ─── ADD LOG ─────────────────────────────────────────────────────────
local function addLog(label, id, signalType)
    if suppressCounter > 0 then return end

    local e = logScroll:FindFirstChild("Empty")
    if e then e:Destroy() end

    eventCount += 1
    countLbl.Text = eventCount .. (eventCount == 1 and " event" or " events")

    if #entries >= MAX_ENTRIES then
        local oldest = table.remove(entries, 1)
        if oldest.stopAuto then oldest.stopAuto() end
        if oldest.stopSpam then oldest.stopSpam() end
        if oldest.frame and oldest.frame.Parent then oldest.frame:Destroy() end
    end

    local entry = Instance.new("Frame")
    entry.Size             = UDim2.new(1, 0, 0, ENTRY_HEIGHT)
    entry.BackgroundColor3 = Color3.fromRGB(15, 15, 21)
    entry.BorderSizePixel  = 0
    entry.LayoutOrder      = eventCount
    entry.BackgroundTransparency = 1
    entry.Parent           = logScroll
    local ec = Instance.new("UICorner", entry) ec.CornerRadius = UDim.new(0, 8)
    local es = Instance.new("UIStroke", entry) es.Color = Color3.fromRGB(36, 34, 54) es.Thickness = 1
    TweenService:Create(entry, TweenInfo.new(0.15), {BackgroundTransparency = 0}):Play()

    -- dot
    local dot = Instance.new("Frame")
    dot.Size = UDim2.new(0, 7, 0, 7)
    dot.Position = UDim2.new(0, 10, 0.5, -3)
    dot.BackgroundColor3 = Color3.fromRGB(61, 255, 160)
    dot.BorderSizePixel = 0
    dot.Parent = entry
    local dcc = Instance.new("UICorner", dot) dcc.CornerRadius = UDim.new(1, 0)

    -- type
    local typeLbl = Instance.new("TextLabel")
    typeLbl.Size = UDim2.new(0, 62, 1, 0)
    typeLbl.Position = UDim2.new(0, 22, 0, 0)
    typeLbl.BackgroundTransparency = 1
    typeLbl.Text = label:upper()
    typeLbl.TextColor3 = Color3.fromRGB(140, 130, 190)
    typeLbl.TextSize = 10
    typeLbl.Font = Enum.Font.GothamBold
    typeLbl.TextXAlignment = Enum.TextXAlignment.Left
    typeLbl.Parent = entry

    -- id
    local idLbl = Instance.new("TextLabel")
    idLbl.Size = UDim2.new(0, 90, 1, 0)
    idLbl.Position = UDim2.new(0, 86, 0, 0)
    idLbl.BackgroundTransparency = 1
    idLbl.Text = tostring(id)
    idLbl.TextColor3 = Color3.fromRGB(215, 213, 238)
    idLbl.TextSize = 12
    idLbl.Font = Enum.Font.GothamBold
    idLbl.TextXAlignment = Enum.TextXAlignment.Left
    idLbl.TextTruncate = Enum.TextTruncate.AtEnd
    idLbl.Parent = entry

    local idStr = tostring(id)
    local fireBtn = makeBtn(entry, "fire", 180, 40)
    local spamBtn = makeBtn(entry, "spam", 224, 40)
    local autoBtn = makeBtn(entry, "auto", 268, 40)
    local copyBtn = makeBtn(entry, "copy", 312, 40)

    -- fire once
    fireBtn.MouseButton1Click:Connect(function()
        fireFakeSignal(signalType, id)
        fireBtn.Text = "sent!" fireBtn.TextColor3 = Color3.fromRGB(61, 255, 160)
        task.wait(1.2)
        if fireBtn.Parent then fireBtn.Text = "fire" fireBtn.TextColor3 = Color3.fromRGB(160, 155, 210) end
    end)

    -- spam
    local isSpamming = false
    local spamThread = nil
    local function stopSpam()
        isSpamming = false
        if spamThread then task.cancel(spamThread) spamThread = nil end
        activeSpam[eventCount] = nil
        if spamBtn.Parent then
            spamBtn.Text = "spam" spamBtn.TextColor3 = Color3.fromRGB(160, 155, 210)
            spamBtn.BackgroundColor3 = Color3.fromRGB(18, 18, 26)
        end
    end
    spamBtn.MouseButton1Click:Connect(function()
        if isSpamming then stopSpam() return end
        isSpamming = true
        spamBtn.Text = "stop" spamBtn.TextColor3 = Color3.fromRGB(255, 90, 90)
        spamBtn.BackgroundColor3 = Color3.fromRGB(28, 10, 10)
        spamThread = task.spawn(function()
            while isSpamming do fireFakeSignal(signalType, id) task.wait(SPAM_INTERVAL) end
        end)
        activeSpam[eventCount] = stopSpam
    end)

    -- auto
    local autoActive = false
    local autoThread = nil
    local function stopAuto()
        autoActive = false
        if autoThread then task.cancel(autoThread) autoThread = nil end
        activeAuto[eventCount] = nil
        if autoBtn.Parent then
            autoBtn.Text = "auto" autoBtn.TextColor3 = Color3.fromRGB(160, 155, 210)
            autoBtn.BackgroundColor3 = Color3.fromRGB(18, 18, 26)
        end
    end
    autoBtn.MouseButton1Click:Connect(function()
        if autoActive then stopAuto() return end
        autoActive = true
        autoBtn.Text = "stop" autoBtn.TextColor3 = Color3.fromRGB(255, 200, 0)
        autoBtn.BackgroundColor3 = Color3.fromRGB(28, 22, 6)
        autoThread = task.spawn(function()
            while autoActive do
                fireFakeSignal(signalType, id)
                task.wait(autoSpeed > 0 and (1 / autoSpeed) or 0.01)
            end
        end)
        activeAuto[eventCount] = stopAuto
    end)

    -- copy
    copyBtn.MouseButton1Click:Connect(function()
        pcall(setclipboard, idStr)
        copyBtn.Text = "ok!" copyBtn.TextColor3 = Color3.fromRGB(61, 255, 160)
        task.wait(1.2)
        if copyBtn.Parent then copyBtn.Text = "copy" copyBtn.TextColor3 = Color3.fromRGB(160, 155, 210) end
    end)

    task.defer(function()
        logScroll.CanvasPosition = Vector2.new(0, math.huge)
    end)

    table.insert(entries, {frame = entry, stopAuto = stopAuto, stopSpam = stopSpam})
end

-- ─── STOP ALL ────────────────────────────────────────────────────────
local function stopAll()
    local n = activeCount()
    if n == 0 then notify("no loops running") return end
    local ac = {} for k,v in pairs(activeAuto) do ac[k]=v end for _,fn in pairs(ac) do fn() end
    local sc = {} for k,v in pairs(activeSpam) do sc[k]=v end for _,fn in pairs(sc) do fn() end
    notify(n .. " loop" .. (n==1 and "" or "s") .. " stopped")
end

