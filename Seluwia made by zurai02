-- Load Celestial Interface Suite
local Celestial = loadstring(game:HttpGet("https://raw.githubusercontent.com/yasirjawauni-hub/Zenith/refs/heads/main/Main%20loader.lua%20by%20zurai02"))()

local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")

local player = Players.LocalPlayer

-- Config
local config = {
    autoSpeed = 100,
    spamDelay = 0.1,
}

-- State
local ui = {
    suppressed = false,
    eventCount = 0,
    activeAuto = {},
    activeSpam = {},
}

-- Create Celestial window
local Window = Celestial:CreateWindow({
    Name = "Marketplace Logger",
    Theme = "Nebula",
    Keybind = Enum.KeyCode.RightShift,
    Size = Vector2.new(760, 520),
    ConfigurationSaving = {
        Enabled = true,
        FileName = "marketplace_config"
    }
})

-- Tabs
local EventsTab = Window:CreateTab({ Name = "Events" })
local SettingsTab = Window:CreateTab({ Name = "Settings" })

-- STOP ALL
local function stopAll()
    for _, data in pairs(ui.activeAuto) do if data.loop then task.cancel(data.loop) end end
    for _, data in pairs(ui.activeSpam) do if data.loop then task.cancel(data.loop) end end
    table.clear(ui.activeAuto)
    table.clear(ui.activeSpam)
    Celestial:Notify({ Title = "Stopped", Content = "All Auto/Spam loops cancelled.", Type = "warn" })
end

EventsTab:CreateButton({
    Name = "Stop All",
    Description = "Cancel all Auto/Spam loops",
    Callback = stopAll
})

-- SIGNAL FIRING
local function fireFakeSignal(signalType, id)
    if ui.suppressed then return end
    ui.suppressed = true
    task.defer(function() ui.suppressed = false end)

    pcall(function()
        if signalType == "Product" then
            MarketplaceService:SignalPromptProductPurchaseFinished(player.UserId, id, true)
        elseif signalType == "Gamepass" then
            MarketplaceService:SignalPromptGamePassPurchaseFinished(player, id, true)
        elseif signalType == "Bulk" then
            MarketplaceService:SignalPromptBulkPurchaseFinished(player.UserId, id, true)
        elseif signalType == "Purchase" then
            MarketplaceService:SignalPromptPurchaseFinished(player.UserId, id, true)
        end
    end)
end

-- ADD LOG ENTRY
local function addLog(label, id, signalType)
    ui.eventCount += 1
    local section = EventsTab:CreateSection(label .. " | ID: " .. tostring(id))

    -- Auto button
    EventsTab:CreateButton({
        Name = "Auto",
        Description = "Auto-fire signal",
        Callback = function(btn)
            if ui.activeAuto[btn] then
                task.cancel(ui.activeAuto[btn].loop)
                ui.activeAuto[btn] = nil
                Celestial:Notify({ Title = "Auto stopped", Type = "info" })
            else
                local loop = task.spawn(function()
                    local delay = config.autoSpeed > 0 and (1 / config.autoSpeed) or 0.01
                    while btn and ui.activeAuto[btn] do
                        fireFakeSignal(signalType, id)
                        task.wait(delay)
                    end
                end)
                ui.activeAuto[btn] = { loop = loop }
                Celestial:Notify({ Title = "Auto started", Type = "success" })
            end
        end
    })

    -- Copy button
    EventsTab:CreateButton({
        Name = "Copy ID",
        Description = "Copy to clipboard",
        Callback = function()
            pcall(setclipboard, tostring(id))
            Celestial:Notify({ Title = "Copied!", Content = tostring(id), Type = "success" })
        end
    })

    -- Run button (spam)
    EventsTab:CreateButton({
        Name = "Run Spam",
        Description = "Spam signal",
        Callback = function(btn)
            if ui.activeSpam[btn] then
                task.cancel(ui.activeSpam[btn].loop)
                ui.activeSpam[btn] = nil
                Celestial:Notify({ Title = "Spam stopped", Type = "info" })
            else
                local loop = task.spawn(function()
                    while btn and ui.activeSpam[btn] do
                        fireFakeSignal(signalType, id)
                        task.wait(config.spamDelay)
                    end
                end)
                ui.activeSpam[btn] = { loop = loop }
                Celestial:Notify({ Title = "Spam started", Type = "success" })
            end
        end
    })
end

-- SETTINGS TAB
SettingsTab:CreateSection("Configuration")

SettingsTab:CreateButton({
    Name = "Set Auto Speed",
    Description = "Default: 100 signals/sec",
    Callback = function()
        config.autoSpeed = 200
        Celestial:Notify({ Title = "Auto speed updated", Content = tostring(config.autoSpeed), Type = "success" })
    end
})

SettingsTab:CreateButton({
    Name = "Set Spam Delay",
    Description = "Default: 0.1s",
    Callback = function()
        config.spamDelay = 0.05
        Celestial:Notify({ Title = "Spam delay updated", Content = tostring(config.spamDelay), Type = "success" })
    end
})

-- Example injection of events
task.delay(2, function()
    addLog("Product", 123456, "Product")
    addLog("Gamepass", 78910, "Gamepass")
end)

Celestial:Notify({
    Title = "UI Loaded",
    Content = "Celestial Interface Suite is active.",
    Type = "success",
    Duration = 5
})
